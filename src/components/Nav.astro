---
import ThemeToggle from './ThemeToggle.astro';

/**
 * Site navigation: three flat destinations, no dropdowns. The current route is
 * marked with aria-current so it is announced, and underlined so it is not
 * signalled by colour alone.
 */
const links = [
  { href: '/', label: 'Work' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
] as const;

const path = Astro.url.pathname;

function isCurrent(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}
---

<header class="site-header">
  <div class="page bar">
    <a class="wordmark" href="/">
      Jayson Petersen
    </a>

    <nav aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  /* Named, so a page transition leaves the header standing still while the
     content beneath it changes. */
  .site-header {
    view-transition-name: site-header;
  }

  /* Name on the left, the toggle on the right, and below 36rem the nav takes
     a row of its own underneath rather than squeezing the name. */
  .bar {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-3);
    align-items: center;
    padding-block: var(--space-2);
  }

  .wordmark {
    margin-inline-end: auto;
    color: var(--color-fg);
    font-size: var(--text-base);
    font-weight: 700;
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--color-accent);
  }

  nav {
    order: 3;
    flex-basis: 100%;
  }

  @media (min-width: 36rem) {
    nav {
      order: 0;
      flex-basis: auto;
    }
  }

  ul {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    /* 44px tall tap target on touch, without changing the visual rhythm. */
    padding-block: var(--space-1);
    color: var(--color-muted);
    font-weight: 500;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-fg);
  }

  /* Current page is both coloured and underlined — never colour alone. */
  nav a[aria-current='page'] {
    color: var(--color-fg);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }
</style>
