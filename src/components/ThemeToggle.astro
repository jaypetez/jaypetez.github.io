---
/**
 * Cycles system -> light -> dark. The only client-side JavaScript on the site
 * (~700 bytes). The button is icon-free text so it needs no icon font, and it
 * carries an aria-label because "Auto" alone doesn't say what it controls.
 *
 * The no-flash inline script that reads the stored preference lives in
 * BaseLayout, where it can run before first paint.
 */
---

<button id="theme-toggle" type="button" class="mono" aria-label="Colour theme: system">
  <span data-theme-label>Auto</span>
</button>

<style>
  /* No border box: the toggle sits in the header as a peer of the nav
     labels, distinguished by being lowercase — a config value, not a page. */
  button {
    padding: var(--space-1);
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    letter-spacing: inherit;
    text-transform: lowercase;
    cursor: pointer;
    transition: color var(--duration) var(--ease);
  }

  button:hover {
    color: var(--color-fg);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 0.3em;
  }
</style>

<script>
  type Mode = 'system' | 'light' | 'dark';

  const LABELS: Record<Mode, string> = { system: 'Auto', light: 'Light', dark: 'Dark' };
  const ORDER: readonly Mode[] = ['system', 'light', 'dark'];

  function read(): Mode {
    const stored = localStorage.getItem('theme');
    return stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
  }

  function apply(mode: Mode): void {
    const root = document.documentElement;
    if (mode === 'system') {
      root.removeAttribute('data-theme');
      localStorage.removeItem('theme');
    } else {
      root.setAttribute('data-theme', mode);
      localStorage.setItem('theme', mode);
    }

    const button = document.getElementById('theme-toggle');
    const label = button?.querySelector('[data-theme-label]');
    if (label) label.textContent = LABELS[mode];
    button?.setAttribute('aria-label', `Colour theme: ${mode}`);
  }

  function init(): void {
    apply(read());
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = ORDER[(ORDER.indexOf(read()) + 1) % ORDER.length]!;
      apply(next);
    });
  }

  init();
  // A prerendered page ran init() before it was shown; refresh the label on
  // reveal in case the theme was changed in another page in between.
  addEventListener('pagereveal', () => apply(read()));
</script>
