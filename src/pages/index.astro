---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import PostMeta from '../components/PostMeta.astro';
import StackFigure from '../components/StackFigure.astro';
import { projects } from '../data/projects';
import { latest } from '../lib/posts';

const posts = latest<CollectionEntry<'blog'>>(await getCollection('blog'), 3, import.meta.env.DEV);
---

<BaseLayout
  title="Jayson Petersen"
  description="Jayson Petersen builds AI agents, self-hosted LLM tooling, and the infrastructure that runs them. Open source projects and writing."
>
  <section class="intro">
    <h1>Jayson Petersen</h1>
    <p class="lede">
      I build agents that do real work, and the infrastructure that keeps them running &mdash;
      self-hosted, model-agnostic, and open source.
    </p>
    <StackFigure />
  </section>

  <section aria-labelledby="work">
    <h2 class="section-label mono" id="work">Work</h2>
    {projects.map((project) => <ProjectRow project={project} />)}
  </section>

  <section aria-labelledby="writing">
    <h2 class="section-label mono" id="writing">Writing</h2>
    {
      posts.length === 0 ? (
        <p class="empty">No posts yet.</p>
      ) : (
        <ul class="posts">
          {posts.map((post) => (
            <li>
              <h3 class="title">
                <a href={`/writing/${post.id}/`}>{post.data.title}</a>
              </h3>
              <PostMeta pubDate={post.data.pubDate} tags={post.data.tags} />
              <p class="excerpt">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
    <p><a class="mono more" href="/writing/">All writing &rarr;</a></p>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-8) var(--space-6);
  }

  /* Fluid between the two scale steps so the name never wraps at 320px. */
  .intro h1 {
    font-size: clamp(var(--text-2xl), 7.5vw, var(--text-3xl));
  }

  .lede {
    max-width: var(--measure);
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  section + section {
    margin-top: var(--space-8);
  }

  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts > li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .posts > li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .posts h3 {
    margin-bottom: var(--space-1);
    font-size: var(--text-lg);
  }

  .posts h3 a {
    color: var(--color-fg);
    text-decoration-color: var(--color-rule);
  }

  .posts h3 a:hover {
    color: var(--color-accent);
    text-decoration-color: currentcolor;
  }

  .excerpt {
    max-width: var(--measure);
    margin-top: var(--space-1);
    color: var(--color-muted);
  }

  .empty {
    color: var(--color-muted);
  }

  .more {
    display: inline-block;
    margin-top: var(--space-3);
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }
</style>
