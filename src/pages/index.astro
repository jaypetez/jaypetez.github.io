---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import PostRow from '../components/PostRow.astro';
import StackMap from '../components/StackMap.astro';
import { projects } from '../data/projects';
import { publishedPosts } from '../lib/posts';

const posts = publishedPosts<CollectionEntry<'blog'>>(
  await getCollection('blog'),
  import.meta.env.DEV,
);
const latest = posts.slice(0, 3);
---

<BaseLayout
  title="Jayson Petersen"
  description="Jayson Petersen builds AI agents, self-hosted LLM tooling, and the infrastructure that runs them. Open source projects and writing."
>
  <!--
    The cover: what I do in one sentence, then the stack that sentence refers
    to. The name is already in the header and the title, so the headline is
    the work rather than the person.
  -->
  <section class="intro">
    <h1>I build agents that do real work, and the infrastructure that keeps them running.</h1>
    <p class="sub serif">Self-hosted, model-agnostic, and open source.</p>
    <StackMap />
  </section>

  <section aria-labelledby="work" data-pagefind-body data-pagefind-meta="title:Work">
    <div class="section-head">
      <h2 id="work">Work</h2>
      <a href="https://github.com/jaypetez">All on GitHub</a>
    </div>
    {projects.map((project) => (
      <ProjectRow project={project} />
    ))}
  </section>

  <section aria-labelledby="writing">
    <div class="section-head">
      <h2 id="writing">Writing</h2>
      <a href="/writing/">{posts.length === 1 ? 'The one essay' : `All ${posts.length} essays`}</a>
    </div>
    {latest.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <ul class="posts">
        {latest.map((post) => (
          <PostRow post={post} headingLevel="h3" />
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-8) var(--space-6);
  }

  h1 {
    max-width: 20em;
    font-size: var(--text-display);
    line-height: var(--leading-tight);
  }

  .sub {
    margin-top: var(--space-2);
    margin-bottom: var(--space-8);
    color: var(--color-muted);
    font-size: var(--text-xl);
  }

  section + section {
    margin-top: var(--space-8);
  }

  /* The section's name, with the way to see all of it at the far end. */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-3);
  }

  .section-head a {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    color: var(--color-muted);
  }
</style>
