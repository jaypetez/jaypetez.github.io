---
/**
 * Search over the essays, the About page, and the Work list, from a static
 * index Pagefind builds out of dist/ after Astro is done.
 *
 * Progressive in three steps. Without JavaScript, the header's "Search" is a
 * link to /search/, which explains what to browse instead. With it, the link
 * opens a dialog in place, and Ctrl+K (Cmd+K on a Mac) opens it from
 * anywhere; a modifier shortcut, because a bare "/" would capture a key screen
 * reader and voice users rely on (WCAG 2.1.4). The index itself, pagefind.js
 * and its WebAssembly, is fetched only the first time someone opens search,
 * so no page pays for it up front.
 *
 * mode="page" renders the same form inline, for /search/ itself.
 */
interface Props {
  mode?: 'dialog' | 'page';
}

const { mode = 'dialog' } = Astro.props;
---

{mode === 'dialog' ? (
  <>
    <a class="trigger" href="/search/" data-search-trigger aria-keyshortcuts="Control+K Meta+K">
      Search
    </a>
    <dialog class="search" aria-labelledby="search-title" data-search-dialog>
      <div class="panel">
        <div class="bar">
          <h2 id="search-title">Search the site</h2>
          <form method="dialog">
            <button class="close" type="submit">
              Close
            </button>
          </form>
        </div>
        <form role="search" class="form" data-search-form>
          <label class="visually-hidden" for="search-input">
            Search the essays and projects
          </label>
          <input id="search-input" type="search" autocomplete="off" spellcheck="false" />
        </form>
        <p class="label status" role="status" data-search-status></p>
        <ol class="results" data-search-results></ol>
      </div>
    </dialog>
  </>
) : (
  <div class="panel inline" data-search-page>
    <form role="search" class="form" data-search-form action="/search/">
      <label class="visually-hidden" for="search-page-input">
        Search the essays and projects
      </label>
      <input id="search-page-input" name="q" type="search" autocomplete="off" spellcheck="false" />
    </form>
    <p class="label status" role="status" data-search-status></p>
    <ol class="results" data-search-results></ol>
  </div>
)}

<style>
  .trigger {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-muted);
    font-weight: 500;
    text-decoration: none;
  }

  .trigger:hover {
    color: var(--color-fg);
  }

  /* A sheet laid on the page, not a floating card: a line round it and the
     page dimmed behind it, with no shadow and no blur. */
  .search {
    width: min(40rem, calc(100% - 2 * var(--space-2)));
    max-height: min(36rem, calc(100dvh - 2 * var(--space-6)));
    margin: var(--space-6) auto auto;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-chip);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-bg);
    color: var(--color-fg);
  }

  /* Dimmed in both themes: ink over light paper, paper over dark. */
  .search::backdrop {
    background: light-dark(
      color-mix(in oklab, var(--color-fg) 40%, transparent),
      color-mix(in oklab, var(--color-bg) 75%, transparent)
    );
  }

  .panel {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
  }

  .inline {
    padding: 0;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .bar h2 {
    font-size: var(--text-lg);
  }

  .close {
    padding: var(--space-1);
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .close:hover {
    color: var(--color-fg);
  }

  input {
    width: 100%;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-chip);
    background: var(--color-bg);
    color: var(--color-fg);
    font: inherit;
    font-size: var(--text-lg);
  }

  .status:empty {
    display: none;
  }

  .results {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Results read like the writing ledger: a rule between rows, the title in
     the serif, the matching passage beneath with the match picked out. */
  .results :global(li) {
    border-top: 1px solid var(--color-border);
  }

  .results :global(a) {
    display: grid;
    gap: 0.25rem;
    padding-block: var(--space-2);
    color: var(--color-fg);
    text-decoration: none;
  }

  .results :global(.title) {
    font-family: var(--face-serif);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .results :global(a:hover .title) {
    color: var(--color-accent);
  }

  .results :global(.excerpt) {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .results :global(mark) {
    background: var(--color-selection);
    color: var(--color-fg);
  }
</style>

<!--
  Bundled, so it is minified and appears once per page even where the form is
  rendered twice (/search/). The index is imported at run time from the built
  site; astro.config.mjs marks it external, and src/pagefind.d.ts types it.
-->
<script>
  /** The slice of Pagefind's browser API this uses. */
  interface Pagefind {
    /** Resolves null when a newer call has superseded this one. */
    debouncedSearch(
      term: string,
      options?: object,
      debounceMs?: number,
    ): Promise<{ results: { data(): Promise<Result> }[] } | null>;
  }

  interface Result {
    url: string;
    /** Page text around the match, HTML-escaped, with the match in <mark>. */
    excerpt: string;
    meta: { title?: string };
  }

  // Built by `pagefind` after astro build; absent under astro dev, where the
  // import fails and the form says how to try it.
  let loading: Promise<Pagefind | null> | undefined;
  function load(): Promise<Pagefind | null> {
    if (!loading) {
      // @ts-expect-error -- the module only exists in dist/, written by pagefind after the build
      const index: Promise<Pagefind> = import('/pagefind/pagefind.js');
      loading = index.catch(() => null);
    }
    return loading;
  }

  function bind(root: HTMLElement): HTMLInputElement | null {
    const input = root.querySelector<HTMLInputElement>('input[type="search"]');
    const status = root.querySelector<HTMLElement>('[data-search-status]');
    const list = root.querySelector<HTMLOListElement>('[data-search-results]');
    const form = root.querySelector<HTMLFormElement>('[data-search-form]');
    if (!input || !status || !list || !form) return null;
    form.addEventListener('submit', (event) => event.preventDefault());

    input.addEventListener('input', async () => {
      const term = input.value.trim();
      if (!term) {
        list.replaceChildren();
        status.textContent = '';
        return;
      }
      const pagefind = await load();
      if (!pagefind) {
        status.textContent =
          'Search is built with the site: run npm run build, then npm run preview.';
        return;
      }
      const search = await pagefind.debouncedSearch(term, {}, 150);
      if (!search) return; // superseded by a newer keystroke
      const total = search.results.length;
      const results = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
      list.replaceChildren(
        ...results.map((result) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = result.url;
          const title = document.createElement('span');
          title.className = 'title';
          title.textContent = result.meta.title || result.url;
          const excerpt = document.createElement('span');
          excerpt.className = 'excerpt';
          // Pagefind escapes the page text and adds only <mark> round the match.
          excerpt.innerHTML = result.excerpt;
          link.append(title, excerpt);
          item.append(link);
          return item;
        }),
      );
      status.textContent =
        total === 0
          ? 'Nothing matches “' + term + '”.'
          : total === 1
            ? '1 result'
            : total + ' results' + (total > 8 ? ', the first 8 shown' : '');
    });
    return input;
  }

  // The header renders before the page's own search form, so wait for the
  // whole document before looking for it.
  function init() {
    const page = document.querySelector<HTMLElement>('[data-search-page]');
    const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
    const trigger = document.querySelector<HTMLAnchorElement>('[data-search-trigger]');
    const pageInput = page && bind(page);
    const dialogInput = dialog && bind(dialog);

    function open() {
      load(); // start fetching the index while the visitor types
      if (pageInput) return pageInput.focus();
      if (dialog && dialogInput && !dialog.open) {
        dialog.showModal();
        dialogInput.select();
      }
    }

    trigger?.addEventListener('click', (event) => {
      event.preventDefault();
      open();
    });

    addEventListener('keydown', (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        open();
      }
    });

    // A click on the dimmed backdrop, outside the panel, closes the dialog.
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // A search field spends its first Escape on clearing itself; in the
    // dialog, Escape should close, as it does everywhere else.
    dialog?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        dialog.close();
      }
    });

    // /search/?q=... arrives with the query already typed.
    const query = new URLSearchParams(location.search).get('q');
    if (pageInput && query) {
      pageInput.value = query;
      pageInput.dispatchEvent(new Event('input'));
    }
  }

  if (document.readyState === 'loading') addEventListener('DOMContentLoaded', init);
  else init();
</script>
