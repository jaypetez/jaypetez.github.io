---
import { formatDate, toISODate } from '../lib/format';
import { normalizeTags } from '../lib/posts';

interface Props {
  pubDate: Date;
  updatedDate?: Date | undefined;
  minutes?: number | undefined;
  tags?: readonly string[];
}

const { pubDate, updatedDate, minutes, tags = [] } = Astro.props;
const keywords = normalizeTags(tags);
---

<!--
  The dateline under an essay's title: facts set apart by space rather than
  joined by separators, and the topics as links to their pages.
-->
<div class="meta label">
  <p>
    <time datetime={toISODate(pubDate)}>{formatDate(pubDate)}</time>
  </p>
  {updatedDate && (
    <p>
      Updated <time datetime={toISODate(updatedDate)}>{formatDate(updatedDate)}</time>
    </p>
  )}
  {minutes !== undefined && <p>{minutes} min read</p>}
  {keywords.length > 0 && (
    <p class="tags">
      <span class="visually-hidden">Tagged</span>
      {keywords.map((tag) => (
        <a class="tag" href={`/writing/topics/${tag}/`}>
          {tag}
        </a>
      ))}
    </p>
  )}
</div>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    align-items: baseline;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
  }
</style>
