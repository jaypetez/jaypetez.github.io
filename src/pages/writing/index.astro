---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { publishedPosts } from '../../lib/posts';

const posts = publishedPosts<CollectionEntry<'blog'>>(
  await getCollection('blog'),
  import.meta.env.DEV,
);
---

<BaseLayout
  title="Writing"
  description="Notes on building AI agents, self-hosted LLM infrastructure, and the engineering decisions behind them."
>
  <div class="head">
    <h1>Writing</h1>
    <p class="lede">
      Notes on agents, self-hosted inference, and decisions I had to think about twice.
    </p>
  </div>

  {
    posts.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <PostRow post={post} />
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-8) var(--space-4);
  }

  .lede {
    max-width: var(--measure);
    margin-top: var(--space-2);
    color: var(--color-muted);
  }

  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    color: var(--color-muted);
  }
</style>
