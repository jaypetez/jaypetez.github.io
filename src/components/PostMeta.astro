---
import { formatDate, toISODate } from '../lib/format';

interface Props {
  pubDate: Date;
  updatedDate?: Date | undefined;
  minutes?: number | undefined;
  tags?: readonly string[];
}

const { pubDate, updatedDate, minutes, tags = [] } = Astro.props;
---

<p class="meta mono">
  <time datetime={toISODate(pubDate)}>{formatDate(pubDate)}</time>
  {
    updatedDate && (
      <>
        <span aria-hidden="true">&middot;</span>
        <span>
          Updated <time datetime={toISODate(updatedDate)}>{formatDate(updatedDate)}</time>
        </span>
      </>
    )
  }
  {
    minutes !== undefined && (
      <>
        <span aria-hidden="true">&middot;</span>
        <span>{minutes} min read</span>
      </>
    )
  }
  {
    tags.length > 0 && (
      <span class="tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </span>
    )
  }
</p>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: baseline;
    /* Kept to the prose measure so the tags sit with the text they describe
       rather than drifting to the far page edge. */
    max-width: var(--measure);
    color: var(--color-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-inline-start: auto;
  }

  .tag {
    padding: 0.1em 0.4em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-chip);
  }
</style>
