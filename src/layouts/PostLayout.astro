---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import TableOfContents from '../components/TableOfContents.astro';
import EssayFooter from '../components/EssayFooter.astro';
import '../styles/prose.css';
import '../styles/essay.css';

interface Entry {
  readonly id: string;
  readonly data: { readonly title: string };
}

interface Props {
  /** The post's id, which names its title for the view transition. */
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date | undefined;
  minutes: number;
  tags?: readonly string[];
  /** From render(post); drives the contents list. */
  headings?: readonly MarkdownHeading[];
  /** For the essay footer: neighbours in date order, and related by topic. */
  older?: Entry | undefined;
  newer?: Entry | undefined;
  related?: readonly Entry[];
}

const {
  id,
  title,
  description,
  pubDate,
  updatedDate,
  minutes,
  tags = [],
  headings = [],
  older,
  newer,
  related = [],
} = Astro.props;
---

<BaseLayout title={title} description={description} type="article" width="wide">
  <div class="progress" aria-hidden="true"></div>

  <article class="post" data-pagefind-body>
    <header>
      <h1 class="title" style={`view-transition-name: post-${id}`}>
        {title}
      </h1>
      <!-- The standfirst: the description, which already says what the essay
           argues in one or two sentences, set where a reader decides to start. -->
      <p class="standfirst serif">{description}</p>
      <PostMeta pubDate={pubDate} updatedDate={updatedDate} minutes={minutes} tags={tags} />
    </header>

    <div class="rail">
      <TableOfContents headings={headings} />
    </div>

    <div class="prose essay-body">
      <slot />
    </div>

    <div class="after">
      <EssayFooter older={older} newer={newer} related={related} />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-8) 0;
  }

  header {
    max-width: 48rem;
    margin-bottom: var(--space-6);
  }

  /* Fluid between the display steps, so a two-line title on a phone does not
     become four. */
  h1 {
    font-size: var(--text-display);
    line-height: var(--leading-tight);
  }

  .standfirst {
    margin-block: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .rail {
    margin-bottom: var(--space-4);
  }

  .after {
    margin-top: var(--space-8);
  }

  /*
   * From 64rem: a contents rail on the left, sticky beside the text, with the
   * header and footer aligned to the text column rather than the rail. The
   * rail sits in the body row only, so it starts level with the first
   * paragraph and stops with the essay, never riding over the footer.
   */
  @media (min-width: 64rem) {
    .post {
      display: grid;
      grid-template-columns: var(--rail) minmax(0, 1fr);
      grid-template-areas:
        '. header'
        'rail body'
        '. after';
      column-gap: var(--space-6);
    }

    header {
      grid-area: header;
    }

    .essay-body {
      grid-area: body;
    }

    .after {
      grid-area: after;
      max-width: var(--measure);
    }

    .rail {
      position: sticky;
      top: var(--space-4);
      grid-area: rail;
      align-self: start;
      max-height: calc(100dvh - var(--space-8));
      margin-bottom: 0;
      overflow-y: auto;
    }
  }

  /*
   * From 80rem: a right margin as wide as the rail, where margin notes and
   * pull quotes go. The text column is then exactly the measure, so the body
   * drops its own max-width and the notes can count on its edge.
   */
  @media (min-width: 80rem) {
    .post {
      grid-template-columns: var(--rail) minmax(0, 1fr) var(--rail);
      grid-template-areas:
        '. header header'
        'rail body .'
        '. after .';
    }

    .essay-body {
      max-width: none;
    }
  }
</style>
