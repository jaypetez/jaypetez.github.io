---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date | undefined;
  minutes: number;
  tags?: readonly string[];
  /** From render(post); drives the margin table of contents. */
  headings?: readonly MarkdownHeading[];
}

const { title, description, pubDate, updatedDate, minutes, tags = [], headings = [] } = Astro.props;
---

<BaseLayout title={title} description={description} type="article">
  <article class="post">
    <header>
      <h1 class="title">{title}</h1>
      <PostMeta pubDate={pubDate} updatedDate={updatedDate} minutes={minutes} tags={tags} />
    </header>

    <!--
      The right margin, which is empty on a wide screen and does not exist on a
      phone. It holds the contents list beside the essay from 64rem up; below
      that the list is hidden rather than stacked above the text, where it
      would be a screen of chrome before the first sentence.
    -->
    <div class="margin">
      <TableOfContents headings={headings} />
    </div>

    <div class="prose body">
      <slot />
    </div>

    <footer>
      <a class="mono" href="/writing/">&larr; All writing</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-6);
  }

  header {
    max-width: var(--measure);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }

  /* Fluid between the two scale steps: display size on a desktop, one step
     down on a phone so a two-line title does not become four. */
  header h1 {
    margin-bottom: var(--space-2);
    font-size: clamp(var(--text-2xl), 1.25rem + 2vw, var(--text-3xl));
  }

  .body {
    margin-top: var(--space-4);
    counter-reset: section;
  }

  .margin {
    display: none;
  }

  @media (min-width: 64rem) {
    .post {
      display: grid;
      grid-template-areas:
        'header .'
        'body margin'
        'footer .';
      grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
      column-gap: var(--space-8);
    }

    header {
      grid-area: header;
    }

    .body {
      grid-area: body;
    }

    footer {
      grid-area: footer;
    }

    /* Placed in the body row only, so it starts level with the first
       paragraph and stops sticking when the essay ends. */
    .margin {
      display: block;
      grid-area: margin;
      position: sticky;
      top: var(--space-6);
      align-self: start;
      margin-top: var(--space-4);
    }
  }

  /* RFC-style section numbers, from the same count the contents list uses.
     The empty alternative text keeps screen readers from announcing "1." as
     part of the heading. Markdown output sits outside this component's
     scope, hence :global. */
  .body :global(h2) {
    counter-increment: section;
    /* Room for the header when a contents link jumps here. */
    scroll-margin-top: var(--space-4);
  }

  .body :global(h2)::before {
    content: counter(section) '. ' / '';
    color: var(--color-muted);
  }

  footer {
    margin-top: var(--space-8);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule);
  }

  footer a {
    text-decoration: none;
  }

  footer a:hover {
    text-decoration: underline;
  }
</style>
