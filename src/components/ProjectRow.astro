---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="row">
  <!--
    The ledger line: name, language, licence, stars on fixed ch-wide columns,
    so the alignment holds across every row the way `ls -l` output does. The
    column widths are set for the longest values in src/data/projects.ts
    (ollama-mobile, TypeScript, Apache-2.0).
  -->
  <div class="ledger">
    <h3>
      <a href={project.repo} rel="noopener">{project.name}</a>
    </h3>
    <span class="lang">{project.language}</span>
    <span class="license">{project.license}</span>
    <span class="tail">
      {
        project.stars !== undefined && (
          <span>
            {/* The glyph is decorative; the number needs the word for screen readers. */}
            <span aria-hidden="true">&#9733;</span>
            <span class="visually-hidden">GitHub stars:</span>
            {project.stars}
          </span>
        )
      }
      {
        project.docs && (
          <a class="docs" href={project.docs}>
            docs
          </a>
        )
      }
    </span>
  </div>

  <p class="description">{project.description}</p>
</article>

<style>
  /* A rule between rows, not a box around each — the card grid is the single
     most recognisable AI-generated layout, and this is the deliberate opposite. */
  .row {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .row:first-of-type {
    border-top: 1px solid var(--color-border);
  }

  .ledger {
    display: grid;
    grid-template-areas: 'name lang license tail';
    /* Sized to the longest value each column holds, plus one space, exactly
       the way `ls` pads its columns — contiguous, not justified apart. */
    grid-template-columns: 15ch 11ch 11ch auto;
    align-items: baseline;
    column-gap: 1ch;
    font-family: var(--font-mono), ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* Below ~384px the full line cannot hold 42 columns at a readable size, so
     the metadata drops to a second line — still on the same column grid. */
  @media (max-width: 24rem) {
    .ledger {
      grid-template-areas:
        'name name tail'
        'lang license license';
      grid-template-columns: 15ch 11ch auto;
      row-gap: var(--space-1);
    }
  }

  h3 {
    grid-area: name;
    font-size: inherit;
    font-weight: 500;
    letter-spacing: 0;
  }

  h3 a {
    color: var(--color-fg);
    text-decoration-color: var(--color-rule);
  }

  h3 a:hover {
    color: var(--color-accent);
    text-decoration-color: currentcolor;
  }

  .lang {
    grid-area: lang;
  }

  .license {
    grid-area: license;
  }

  .tail {
    display: flex;
    grid-area: tail;
    gap: var(--space-2);
  }

  .description {
    max-width: var(--measure);
    margin-top: var(--space-2);
    color: var(--color-muted);
  }
</style>
