---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page does not exist on jaypetez.github.io.">
  <div class="wrap">
    <p class="label">Error 404</p>
    <h1>That page doesn&rsquo;t exist</h1>
    <p class="lede serif">
      The link may be out of date, or I may have moved something. Both are usually my fault.
    </p>
    <ul class="links">
      <li>
        <a href="/">Work</a>
      </li>
      <li>
        <a href="/writing/">Writing</a>
      </li>
      <li>
        <a href="/writing/topics/">Topics</a>
      </li>
      <li>
        <a href="/about/">About</a>
      </li>
    </ul>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--measure);
    padding-block: var(--space-12);
  }

  h1 {
    margin-block: var(--space-1) var(--space-2);
    font-size: var(--text-display);
  }

  .lede {
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
    font-weight: 500;
  }
</style>
