---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import { publishedPosts } from '../../lib/posts';

const posts = publishedPosts<CollectionEntry<'blog'>>(
  await getCollection('blog'),
  import.meta.env.DEV,
);
---

<BaseLayout
  title="Writing"
  description="Notes on building AI agents, self-hosted LLM infrastructure, and the engineering decisions behind them."
>
  <div class="head">
    <h1>Writing</h1>
    <p class="lede">
      Notes on agents, self-hosted inference, and decisions I had to think about twice.
    </p>
  </div>

  {
    posts.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <h2>
              <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            </h2>
            <PostMeta pubDate={post.data.pubDate} tags={post.data.tags} />
            <p class="excerpt">{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-8) var(--space-4);
  }

  .lede {
    max-width: var(--measure);
    margin-top: var(--space-2);
    color: var(--color-muted);
  }

  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts > li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .posts > li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .posts h2 {
    margin-bottom: var(--space-1);
  }

  .posts h2 a {
    color: var(--color-fg);
    text-decoration-color: var(--color-rule);
  }

  .posts h2 a:hover {
    color: var(--color-accent);
    text-decoration-color: currentcolor;
  }

  .excerpt {
    max-width: var(--measure);
    margin-top: var(--space-1);
    color: var(--color-muted);
  }

  .empty {
    color: var(--color-muted);
  }
</style>
