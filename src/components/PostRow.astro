---
import { formatDateShort, toISODate } from '../lib/format';
import { normalizeTags } from '../lib/posts';

/**
 * One line of the writing ledger, used by the home page, the writing index,
 * and the topic pages.
 *
 * The date sits in a fixed-width gutter (the `--gutter-date` token, sized for
 * "31 Jul 2026") so every row's title starts on the same column. Below 40rem
 * the gutter has no room and the date moves above the title, still on the
 * same left edge.
 *
 * The heading carries the post's view-transition-name, the same one the
 * essay's h1 carries, so following the link moves the title into place on the
 * next page. It is set on the heading rather than the link because a title
 * that wraps onto two lines is two boxes as a link and one as a block. Each
 * post appears at most once per list, so the name is unique on the page.
 *
 * The prop is typed structurally rather than as CollectionEntry<'blog'> so the
 * component can be rendered in tests with a plain object.
 */
interface Props {
  post: {
    readonly id: string;
    readonly data: {
      readonly title: string;
      readonly description: string;
      readonly pubDate: Date;
      readonly tags?: readonly string[];
    };
  };
  /** h2 on the writing index, h3 under the home page's Writing heading. */
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const tags = normalizeTags(post.data.tags);
---

<li class="row">
  <time class="label date" datetime={toISODate(post.data.pubDate)}>
    {formatDateShort(post.data.pubDate)}
  </time>

  <div class="entry">
    <Heading class="title" style={`view-transition-name: post-${post.id}`}>
      <a href={`/writing/${post.id}/`}>{post.data.title}</a>
    </Heading>
    <p class="excerpt serif">{post.data.description}</p>
    {tags.length > 0 && (
      <p class="label tags">
        <span class="visually-hidden">Tagged</span>
        {tags.map((tag) => (
          <a class="tag" href={`/writing/topics/${tag}/`}>
            {tag}
          </a>
        ))}
      </p>
    )}
  </div>
</li>

<style>
  /* A rule between rows, not a box around each. */
  .row {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .row:first-child {
    border-top: 1px solid var(--color-border);
  }

  .date {
    display: block;
    margin-bottom: var(--space-1);
  }

  /* From 40rem the date takes its gutter and the title starts beside it,
     aligned on the shared baseline. */
  @media (min-width: 40rem) {
    .row {
      display: grid;
      grid-template-columns: var(--gutter-date) minmax(0, 1fr);
      column-gap: var(--space-3);
      align-items: baseline;
    }

    .date {
      margin-bottom: 0;
    }
  }

  .title {
    margin-bottom: var(--space-1);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .title a {
    color: var(--color-fg);
    text-decoration-color: var(--color-rule);
  }

  .title a:hover {
    color: var(--color-accent);
    text-decoration-color: currentcolor;
  }

  .excerpt {
    max-width: var(--measure);
    color: var(--color-muted);
  }

  /* Topics are keywords, printed as typed and spaced apart. Each is a link to
     its topic page. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin-top: var(--space-1);
  }
</style>
