---
import { formatDate, toISODate } from '../lib/format';

// Taken at build time, so the stamp says when this copy of the page was made.
const built = new Date();
---

<footer class="site-footer">
  <div class="page inner">
    <p>
      &copy; {built.getUTCFullYear()} Jayson Petersen.{' '}
      <span class="built">
        Built <time datetime={toISODate(built)}>{formatDate(built)}</time>.
      </span>
    </p>
    <ul>
      <li>
        <a href="https://github.com/jaypetez">GitHub</a>
      </li>
      <li>
        <a href="/rss.xml">RSS</a>
      </li>
      <li>
        <a href="/writing/topics/">Topics</a>
      </li>
      <li>
        <a href="https://github.com/jaypetez/jaypetez.github.io">Source</a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-12);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    justify-content: space-between;
    align-items: baseline;
    padding-block: var(--space-4);
  }

  /* Kept whole, so a narrow screen breaks before the stamp, not inside it. */
  .built {
    white-space: nowrap;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--color-muted);
    text-decoration-color: var(--color-rule);
  }

  a:hover {
    color: var(--color-accent);
    text-decoration-color: currentcolor;
  }
</style>
