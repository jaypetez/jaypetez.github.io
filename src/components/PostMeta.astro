---
import { formatDate, toISODate } from '../lib/format';

interface Props {
  pubDate: Date;
  updatedDate?: Date | undefined;
  minutes?: number | undefined;
  tags?: readonly string[];
}

const { pubDate, updatedDate, minutes, tags = [] } = Astro.props;

// Lowercase and deduplicated at render time, as the content schema promises.
const keywords = [...new Set(tags.map((tag) => tag.toLowerCase()))];
---

<p class="meta mono">
  <time datetime={toISODate(pubDate)}>{formatDate(pubDate)}</time>
  {
    updatedDate && (
      <>
        <span aria-hidden="true">&middot;</span>
        <span>
          Updated <time datetime={toISODate(updatedDate)}>{formatDate(updatedDate)}</time>
        </span>
      </>
    )
  }
  {
    minutes !== undefined && (
      <>
        <span aria-hidden="true">&middot;</span>
        <span>{minutes} min read</span>
      </>
    )
  }
  {
    keywords.length > 0 && (
      <span class="tags">
        {/* Inside the group, so when the tags wrap to a new line the separator goes with them. */}
        <span aria-hidden="true">&middot;</span>
        <span class="visually-hidden">Tagged</span>
        {keywords.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </span>
    )
  }
</p>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: baseline;
    /* Kept to the prose measure so the line sits with the text it describes
       rather than drifting to the far page edge. */
    max-width: var(--measure);
    color: var(--color-muted);
  }

  /* Tags follow the date and reading time as one more item on the line,
     printed as typed: lowercase keywords, no chip, the same middot between
     them. The uppercase of .mono is for labels. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .tag + .tag::before {
    content: '·' / '';
    margin-inline-end: var(--space-1);
  }
</style>
