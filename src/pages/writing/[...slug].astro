---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { neighbours, publishedPosts, related } from '../../lib/posts';
import { readingTime } from '../../lib/format';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = publishedPosts<CollectionEntry<'blog'>>(
    await getCollection('blog'),
    import.meta.env.DEV,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      ...neighbours(posts, post.id),
      related: related(posts, post.id),
    },
  }));
};

// getStaticPaths cannot infer prop types back into the component, so they are
// declared explicitly here.
interface Props {
  post: CollectionEntry<'blog'>;
  newer: CollectionEntry<'blog'> | undefined;
  older: CollectionEntry<'blog'> | undefined;
  related: CollectionEntry<'blog'>[];
}

const { post, newer, older, related: relatedPosts } = Astro.props as Props;
// `headings` is the list Astro extracted while rendering, with the same slugs
// it wrote into the h2 ids — the table of contents links to those.
const { Content, headings } = await render(post);

// Estimated from the raw markdown so fenced code can be discounted.
const minutes = readingTime(post.body ?? '');
---

<PostLayout
  id={post.id}
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  minutes={minutes}
  tags={post.data.tags}
  headings={headings}
  older={older}
  newer={newer}
  related={relatedPosts}
>
  <Content />
</PostLayout>
