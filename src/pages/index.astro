---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import PostRow from '../components/PostRow.astro';
import StackFigure from '../components/StackFigure.astro';
import { projects } from '../data/projects';
import { latest } from '../lib/posts';

const posts = latest<CollectionEntry<'blog'>>(await getCollection('blog'), 3, import.meta.env.DEV);
---

<BaseLayout
  title="Jayson Petersen"
  description="Jayson Petersen builds AI agents, self-hosted LLM tooling, and the infrastructure that runs them. Open source projects and writing."
>
  <!--
    The cover: name and lede on the left, the stack figure on the right from
    56rem up, so the one ornament sits beside the name it belongs to instead of
    below it with the right half of the screen empty. Under 56rem the figure
    drops beneath the lede, centred, as before.
  -->
  <section class="intro">
    <div class="cover">
      <h1>Jayson Petersen</h1>
      <p class="lede">
        I build agents that do real work, and the infrastructure that keeps them running &mdash;
        self-hosted, model-agnostic, and open source.
      </p>
    </div>
    <StackFigure />
  </section>

  <section aria-labelledby="work">
    <h2 class="section-label mono" id="work">Work</h2>
    {projects.map((project) => <ProjectRow project={project} />)}
  </section>

  <section aria-labelledby="writing">
    <h2 class="section-label mono" id="writing">Writing</h2>
    {
      posts.length === 0 ? (
        <p class="empty">No posts yet.</p>
      ) : (
        <ul class="posts">
          {posts.map((post) => (
            <PostRow post={post} headingLevel="h3" />
          ))}
        </ul>
      )
    }
    <p><a class="mono more" href="/writing/">All writing &rarr;</a></p>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    row-gap: var(--space-6);
    padding-block: var(--space-8) var(--space-6);
  }

  @media (min-width: 56rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-8);
      align-items: start;
    }
  }

  /* Fluid between the two scale steps so the name never wraps at 320px. */
  .intro h1 {
    font-size: clamp(var(--text-2xl), 7.5vw, var(--text-3xl));
  }

  .lede {
    max-width: var(--measure);
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  section + section {
    margin-top: var(--space-8);
  }

  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    color: var(--color-muted);
  }

  .more {
    display: inline-block;
    margin-top: var(--space-3);
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }
</style>
